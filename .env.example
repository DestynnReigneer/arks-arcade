# Copy this file to .env and fill in real values. Never commit .env itself.

# Optional. Your arcade's name, shown on the home page as "<name> Arcade".
# ARCADE_NAME=ARKS gives you the ARKS Arcade. Leave blank for just "Arcade".
ARCADE_NAME=

# Your admin password. Required to use the admin panel (public/admin.html);
# leave it blank and the admin panel stays locked to everyone.
# To change it: edit this line, then restart (docker compose up -d, or npm start).
# Anyone who could reach the server can try it, so make it long.
ADMIN_PASSWORD=

# Optional. A Discord "Incoming Webhook" URL for a channel you own.
# Server Settings -> Integrations -> Webhooks -> New Webhook -> copy URL.
# Leave blank to disable Discord notifications for theme requests.
DISCORD_WEBHOOK_URL=

# Optional. Locks every adult option behind a PIN: Rambler's unfiltered words,
# adult Wordless themes, and Short Fuse's spicy decks. Once the arcade is
# running you can change or remove it from the admin page (Arcade tab), which
# then overrides this value.
# Leave blank and a confirmation tap is all that guards it, which is fine on a
# LAN. Set it to any string once the server is reachable from outside, so the
# kids can't just tap through to the adult word list.
ADULT_PIN=

# Your timezone. Rambler's daily challenge and streaks roll over at local
# midnight, so getting this wrong means the daily changes at the wrong time.
TZ=Europe/London

# Know-It-All (trivia) downloads free questions from Open Trivia DB
# (opentdb.com) in the background when the server has internet, and saves
# them so they keep working offline. Set to "off" to never go online.
TRIVIA_ONLINE=

# The address phones use to reach the arcade, for QR codes. A page opened on
# a real address (a LAN IP or a name) uses that address on its own. This is
# only for when you open the arcade as localhost on the server itself: blank
# guesses the machine's LAN address, which works outside Docker. In Docker,
# set it, e.g. http://192.168.1.50:3000 or http://arcade.home
PUBLIC_URL=
