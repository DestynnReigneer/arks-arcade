# Keep the repo LF regardless of who checks it out. Without this, editing on
# Windows and building in a Linux container produces diffs that are pure
# line-ending noise.
* text=auto eol=lf

# Shell scripts run inside Linux containers: a CRLF one fails with
# "/bin/sh^M: not found" when the image is built from a Windows checkout.
*.sh text eol=lf

*.png binary
*.jpg binary
*.ico binary
